{
  "prefix": {
    "default": "%"
  },

  "cli": {
    "exitCode": "$exit",
    "enableCliMode": true
  },

  "command": {
    "path": "./dist/features/commands",
    "defaultCooldownInMs": 3000,
    "flags": {
      "boolValueFlags": {
        "falsy": ["n", "false", "f"],
        "truthy": ["y", "true", "t"]
      }
    }
  },

  "event": {
    "path": "./dist/features/events"
  }
}
